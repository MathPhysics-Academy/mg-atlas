theorem cusp_lcm : ([3,3,3,6,6,7] : List Nat).foldl Nat.lcm 1 = 42 := by decide +kernel
def wordA42 : Word := [s,t,t,t,s,t,t,t,s,t,t,t,s,t,t]
def wordB42 : Word := [t,t,s,t,t,t,s,t,t,t,s,t,t,t,s]
theorem no_factor_mod42 :
    ¬ ∃ f : ResidueMatrix 42 → Fin 56,
      ∀ w : Word, f (matrixOf 42 (by decide +kernel) w) = act S T 0 w :=
  collision_obstructs (by decide +kernel) S T 0 wordA42 wordB42 (by decide +kernel) (by decide +kernel)
#print axioms no_factor_mod42
