theorem cusp_certificate :
    cusps.all (follows qT) = true ∧
    (∀ p : Fin 54, (cusps.flatten.filter (· == p)).length = 1) ∧
    cusps.map List.length = [1,2,3,3,3,4,4,4,6,12,12] := by decide +kernel
theorem genus_arithmetic : (12 * 0 : Int) =
    12 + 54 - 3 * 0 - 4 * 0 - 6 * 11 := by decide +kernel
theorem cusp_lcm : ([1,2,3,3,3,4,4,4,6,12,12] : List Nat).foldl Nat.lcm 1 = 12 := by decide +kernel
def wordA12 : Word := [s,t,t,t,t,s,t,t,t]
def wordB12 : Word := [t,t,t,s,t,t,t,t,s]
theorem no_factor_mod12 :
    ¬ ∃ f : ResidueMatrix 12 → Fin 108,
      ∀ w : Word, f (matrixOf 12 (by decide +kernel) w) = act S T 0 w :=
  collision_obstructs (by decide +kernel) S T 0 wordA12 wordB12 (by decide +kernel) (by decide +kernel)
