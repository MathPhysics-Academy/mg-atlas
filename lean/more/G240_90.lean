    (∀ p, cls (S (S p)) = cls p) ∧
    (∀ q, cls (rep q) = q) ∧
    (∀ p, rep (cls p) = p ∨ rep (cls p) = S (S p)) ∧
    (∀ p, cls (S p) = qS (cls p)) ∧
    (∀ p, cls (T p) = qT (cls p)) := by decide +kernel
theorem quotient_exact (p q : Fin 60) :
    cls p = cls q ↔ q = p ∨ q = S (S p) :=
  central_fibers (fun p => S (S p)) action_relations.1 cls rep
    central_quotient.1 central_quotient.2.2.1 p q
theorem central_sign : ∀ p, S (S p) ≠ p := by decide +kernel
theorem elliptic_counts :
    ((List.finRange 30).filter (fun p => qS p == p)).length = 0 ∧
    ((List.finRange 30).filter (fun p => qT (qS p) == p)).length = 0 := by decide +kernel
def cusps : List (List (Fin 30)) := [[17,25],[22,27],[4,8,15],[6,11,20],[0,2,5,10,18,19],[1,3,7,13,23,14],[9,16,24,28,12,21,26,29]]
theorem cusp_certificate :
    cusps.all (follows qT) = true ∧
    (∀ p : Fin 30, (cusps.flatten.filter (· == p)).length = 1) ∧
    cusps.map List.length = [2,2,3,3,6,6,8] := by decide +kernel
theorem genus_arithmetic : (12 * 0 : Int) =
    12 + 30 - 3 * 0 - 4 * 0 - 6 * 7 := by decide +kernel
theorem cusp_lcm : ([2,2,3,3,6,6,8] : List Nat).foldl Nat.lcm 1 = 24 := by decide +kernel
def wordA24 : Word := [s,t,t,t,s,t,t,t,s,t,t,t]
def wordB24 : Word := [t,t,t,s,t,t,t,s,t,t,t,s]
theorem no_factor_mod24 :
    ¬ ∃ f : ResidueMatrix 24 → Fin 60,
      ∀ w : Word, f (matrixOf 24 (by decide +kernel) w) = act S T 0 w :=
  collision_obstructs (by decide +kernel) S T 0 wordA24 wordB24 (by decide +kernel) (by decide +kernel)
#print axioms no_factor_mod24
def wordA48 : Word := [s,t,t,t,t,t,s,t,t,t,t,t,s,t,t]
def wordB48 : Word := [t,t,s,t,t,t,t,t,s,t,t,t,t,t,s]
theorem no_factor_mod48 :
    ¬ ∃ f : ResidueMatrix 48 → Fin 60,
      ∀ w : Word, f (matrixOf 48 (by decide +kernel) w) = act S T 0 w :=
  collision_obstructs (by decide +kernel) S T 0 wordA48 wordB48 (by decide +kernel) (by decide +kernel)
#print axioms no_factor_mod48
