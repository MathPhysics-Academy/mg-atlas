  toFun := qTMap
  invFun := qTInv
  left_inv := by
    change ∀ p : Fin 1152, qTInv (qTMap p) = p
    decide +kernel
  right_inv := by
    change ∀ p : Fin 1152, qTMap (qTInv p) = p
    decide +kernel
theorem central_quotient :
    (∀ p, cls (S (S p)) = cls p) ∧
    (∀ q, cls (rep q) = q) ∧
    (∀ p, rep (cls p) = p ∨ rep (cls p) = S (S p)) ∧
    (∀ p, cls (S p) = qS (cls p)) ∧
    (∀ p, cls (T p) = qT (cls p)) := by decide +kernel
theorem quotient_exact (p q : Fin 2304) :
    cls p = cls q ↔ q = p ∨ q = S (S p) :=
  central_fibers (fun p => S (S p)) action_relations.1 cls rep
    central_quotient.1 central_quotient.2.2.1 p q
theorem central_sign : ∀ p, S (S p) ≠ p := by decide +kernel
theorem elliptic_counts :
    ((List.finRange 1152).filter (fun p => qS p == p)).length = 0 ∧
    ((List.finRange 1152).filter (fun p => qT (qS p) == p)).length = 0 := by decide +kernel
