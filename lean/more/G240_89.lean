def wordA24 : Word := [s,t,t,t,s,t,t,t,s,t,t,t]
def wordB24 : Word := [t,t,t,s,t,t,t,s,t,t,t,s]
theorem no_factor_mod24 :
    ¬ ∃ f : ResidueMatrix 24 → Fin 60,
      ∀ w : Word, f (matrixOf 24 (by decide +kernel) w) = act S T 0 w :=
  collision_obstructs (by decide +kernel) S T 0 wordA24 wordB24 (by decide +kernel) (by decide +kernel)
#print axioms no_factor_mod24
#print axioms transitive_certificate
end G240_89_C2


-- Audit all transitive dependencies, including generated auxiliary definitions.
run_cmd do
  let allowed : Array Lean.Name := #[``propext, ``Classical.choice, ``Quot.sound]
