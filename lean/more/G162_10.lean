    (∀ q, cls (rep q) = q) ∧
    (∀ p, rep (cls p) = p ∨ rep (cls p) = S (S p)) ∧
    (∀ p, cls (S p) = qS (cls p)) ∧
    (∀ p, cls (T p) = qT (cls p)) := by decide +kernel
