      ∀ w : Word, f (matrixOf 12 (by decide +kernel) w) = act S T 0 w :=
  collision_obstructs (by decide +kernel) S T 0 wordA12 wordB12 (by decide +kernel) (by decide +kernel)
#print axioms no_factor_mod12
def wordA24 : Word := [s,t,t,t,s,t,t,t,s,t,t,t]
def wordB24 : Word := [t,t,t,s,t,t,t,s,t,t,t,s]
theorem no_factor_mod24 :
    ¬ ∃ f : ResidueMatrix 24 → Fin 108,
      ∀ w : Word, f (matrixOf 24 (by decide +kernel) w) = act S T 0 w :=
  collision_obstructs (by decide +kernel) S T 0 wordA24 wordB24 (by decide +kernel) (by decide +kernel)
#print axioms no_factor_mod24
#print axioms transitive_certificate
end G216_88_C1


-- Audit all transitive dependencies, including generated auxiliary definitions.
run_cmd do
  let allowed : Array Lean.Name := #[``propext, ``Classical.choice, ``Quot.sound]
  let mut count : Nat := 0
  for (name, _) in (← Lean.getEnv).constants.toList do
    if name.toString.startsWith "ChenMore." then
      for ax in (← Lean.collectAxioms name) do
        unless allowed.contains ax do
          throwError "Axiom audit failed: {name} depends on {ax}"
      count := count + 1
  Lean.logInfo m!"Axiom audit passed for all {count} ChenMore declarations; allowed: {allowed}"

end ChenMore
