    (∀ q, cls (rep q) = q) ∧
    (∀ p, rep (cls p) = p ∨ rep (cls p) = S (S p)) ∧
    (∀ p, cls (S p) = qS (cls p)) ∧
    (∀ p, cls (T p) = qT (cls p)) := by decide +kernel
theorem quotient_exact (p q : Fin 18) :
    cls p = cls q ↔ q = p ∨ q = S (S p) :=
  central_fibers (fun p => S (S p)) action_relations.1 cls rep
    central_quotient.1 central_quotient.2.2.1 p q
theorem central_sign : ∀ p, S (S p) = p := by decide +kernel
theorem elliptic_counts :
    ((List.finRange 18).filter (fun p => qS p == p)).length = 0 ∧
    ((List.finRange 18).filter (fun p => qT (qS p) == p)).length = 0 := by decide +kernel
def cusps : List (List (Fin 18)) := [[0,2],[13,16],[4,7,11,5],[8,12,15,17],[1,3,6,9,14,10]]
theorem cusp_certificate :
    cusps.all (follows qT) = true ∧
    (∀ p : Fin 18, (cusps.flatten.filter (· == p)).length = 1) ∧
    cusps.map List.length = [2,2,4,4,6] := by decide +kernel
theorem genus_arithmetic : (12 * 0 : Int) =
    12 + 18 - 3 * 0 - 4 * 0 - 6 * 5 := by decide +kernel
theorem cusp_lcm : ([2,2,4,4,6] : List Nat).foldl Nat.lcm 1 = 12 := by decide +kernel
def wordA12 : Word := [s,t,t,t,t,s,t,t,t]
def wordB12 : Word := [t,t,t,s,t,t,t,t,s]
theorem no_factor_mod12 :
    ¬ ∃ f : ResidueMatrix 12 → Fin 18,
      ∀ w : Word, f (matrixOf 12 (by decide +kernel) w) = act S T 0 w :=
  collision_obstructs (by decide +kernel) S T 0 wordA12 wordB12 (by decide +kernel) (by decide +kernel)
#print axioms no_factor_mod12
#print axioms transitive_certificate
end G96_187_C1


-- Audit all transitive dependencies, including generated auxiliary definitions.
run_cmd do
  let allowed : Array Lean.Name := #[``propext, ``Classical.choice, ``Quot.sound]
  let mut count : Nat := 0
  for (name, _) in (← Lean.getEnv).constants.toList do
    if name.toString.startsWith "ChenMore." then
      for ax in (← Lean.collectAxioms name) do
        unless allowed.contains ax do
          throwError "Axiom audit failed: {name} depends on {ax}"
      count := count + 1
  Lean.logInfo m!"Axiom audit passed for all {count} ChenMore declarations; allowed: {allowed}"

end ChenMore
