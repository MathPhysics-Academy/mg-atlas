noncomputable def facesBack (p : Fin 768) : Fin 768 := tableLookup facesBackData p.val
theorem faces_index_inverse : ∀ p : Fin 768, facesBack (facesIndex p) = p := by decide +kernel
theorem faces_enumeration : faces.flatten.map facesIndex = List.finRange 768 := by decide +kernel
theorem faces_partition : ∀ p : Fin 768, (faces.flatten.filter (· == p)).length = 1 :=
 partition_from_index faces facesIndex facesBack faces_index_inverse faces_enumeration
theorem faces_cycles : faces.all (follows T) = true := by decide +kernel
theorem vertex_valencies : vertices.all (fun v => v.length == 1 || v.length == 3) = true := by decide +kernel
theorem edge_valencies : edges.all (fun e => e.length == 1 || e.length == 2) = true := by decide +kernel
theorem cusp_widths : faces.map List.length = [3,16,48,48,24,48,24,12,8,48,48,2,48,16,24,12,48,4,48,16,2,16,6,16,6,16,24,8,12,3,6,12,8,4,16,4,4,16,3,2,3,8,2,3,3,6,3,2,2,3,2,2] := by decide +kernel
theorem euler_arithmetic : (2 - 2 * 39 : Int) = 256 - 384 + 52 + 0 := by decide +kernel
theorem elliptic_counts : (edges.filter (fun e => e.length == 1)).length = 0 ∧ (vertices.filter (fun v => v.length == 1)).length = 0 := by decide +kernel
